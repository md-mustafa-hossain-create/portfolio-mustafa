rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Skills: Anyone can read/view your skills list, but only the admin (via Console) can write.
    match /skills/{skill} {
      allow read: if true;
      allow write: if false;
    }
    
    // 2. Projects: Anyone can read/view your projects list, but only the admin (via Console) can write.
    match /projects/{project} {
      allow read: if true;
      allow write: if false;
    }
    
    // 3. Blogs: Anyone can read/view your blogs list, but only the admin (via Console) can write.
    match /blogs/{blog} {
      allow read: if true;
      allow write: if false;
    }
    
    // Contact messages are public submissions, so accept only the exact form
    // schema and bound every value to limit accidental or abusive writes.
    match /messages/{message} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'timestamp'])
                    && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('.*@.*')
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.timestamp is timestamp
                    && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }
    
    // Default fallback: Block read and write operations on all other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
