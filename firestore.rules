rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Skills: Anyone can read/view your skills list, but only the admin (via Console) can write.
    match /skills/{skill} {
      allow read: if true;
      allow write: if false;
    }
    
    // 2. Projects: Anyone can read/view your projects list, but only the admin (via Console) can write.
    match /projects/{project} {
      allow read: if true;
      allow write: if false;
    }
    
    // 3. Contact Messages: Anyone can submit a message, but no one can read or modify existing messages from the frontend.
    match /messages/{message} {
      allow create: if request.resource.data.name != null 
                    && request.resource.data.email != null 
                    && request.resource.data.message != null
                    && request.resource.data.name.size() > 0
                    && request.resource.data.email.size() > 0
                    && request.resource.data.message.size() > 0;
      allow read, update, delete: if false;
    }
    
    // Default fallback: Block read and write operations on all other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
